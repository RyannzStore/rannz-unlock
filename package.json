{
  "name": "rannz-unlock",
  "version": "1.0.0",
  "description": "RANNZ UNLOCK — Unlock. Resolve. Download. A secure public-link resolver built on Cloudflare Workers + D1.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create rannz-unlock-db",
    "db:migrate:local": "wrangler d1 execute rannz-unlock-db --local --file=./migrations/001_init.sql",
    "db:migrate:remote": "wrangler d1 execute rannz-unlock-db --remote --file=./migrations/001_init.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
